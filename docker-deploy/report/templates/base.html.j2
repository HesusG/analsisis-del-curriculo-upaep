<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Reporte de Evaluación — {{ pdf_name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
/* ========== CSS VARIABLES (neobrutalista) ========== */
:root {
  --bg: #F5F0E8;
  --fg: #1a1a1a;
  --accent: #FFD54F;
  --border: 3px solid #1a1a1a;
  --shadow: 6px 6px 0 #1a1a1a;
  --shadow-sm: 3px 3px 0 #1a1a1a;
  --font-display: 'Syne', sans-serif;
  --font-body: 'DM Sans', sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
  --c1: #E57373;
  --c2: #64B5F6;
  --c3: #81C784;
  --c4: #BA68C8;
  --c5: #FFB74D;
  --c6: #FF8A65;
  --c7: #4DB6AC;
  --c8: #7986CB;
  --max-w: 1100px;
  --gap: 2rem;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { font-size: 18px; }
body {
  font-family: var(--font-body);
  background: var(--bg);
  color: var(--fg);
  line-height: 1.7;
}
h1, h2, h3, h4 { font-family: var(--font-display); line-height: 1.2; font-weight: 800; }
h1 { font-size: clamp(2rem, 5vw, 3.5rem); }
h2 { font-size: clamp(1.5rem, 3.5vw, 2.2rem); margin-bottom: 1rem; }
h3 { font-size: clamp(1.1rem, 2vw, 1.4rem); }

.container { max-width: var(--max-w); margin: 0 auto; padding: 2rem; }
.mono { font-family: var(--font-mono); }
.badge {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 700;
  display: inline-block;
  padding: 0.25rem 0.75rem;
  border: var(--border);
  background: var(--accent);
}

/* ── Hero ── */
.hero {
  background: var(--fg);
  color: var(--bg);
  padding: 4rem 2rem;
  text-align: center;
}
.hero h1 span {
  background: linear-gradient(90deg, var(--accent), #FFE082);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
.hero-subtitle { font-size: 1.1rem; opacity: 0.85; margin: 0.5rem 0 1.5rem; }
.compliance-big {
  font-family: var(--font-display);
  font-size: clamp(3rem, 8vw, 6rem);
  font-weight: 800;
  margin: 0.5rem 0;
}
.compliance-bar {
  width: 100%;
  max-width: 500px;
  height: 20px;
  background: #333;
  border: 2px solid #555;
  margin: 1rem auto;
  position: relative;
}
.compliance-bar-fill {
  height: 100%;
  transition: width 0.5s;
}
.nivel-badge {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  padding: 0.3rem 1rem;
  border: 2px solid;
  display: inline-block;
  margin-top: 0.5rem;
}
.nivel-satisfactorio { border-color: var(--c3); color: var(--c3); }
.nivel-en-proceso { border-color: var(--c5); color: var(--c5); }
.nivel-requiere-atencion { border-color: var(--c1); color: var(--c1); }

/* ── Expert Panel ── */
.expert-panel { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin: 2rem 0; }
.expert-card {
  border: var(--border);
  box-shadow: var(--shadow-sm);
  padding: 1.5rem;
  text-align: center;
  background: var(--bg);
}
.expert-avatar {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  border: var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2rem;
  margin: 0 auto 0.75rem;
}
.expert-card h3 { margin-bottom: 0.25rem; }
.expert-card p { font-size: 0.85rem; opacity: 0.7; }
.expert-compliance {
  font-family: var(--font-mono);
  font-size: 1.5rem;
  font-weight: 700;
  margin-top: 0.5rem;
}

/* ── Sections ── */
.section { padding: 3rem 0; border-top: var(--border); }
.section-num {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 700;
  display: inline-block;
  padding: 0.2rem 0.6rem;
  border: var(--border);
  margin-bottom: 0.75rem;
  color: #fff;
}

/* ── Criteria table ── */
.criteria-table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
.criteria-table th,
.criteria-table td {
  text-align: left;
  padding: 0.6rem 0.8rem;
  border-bottom: 1px solid #ccc;
  font-size: 0.9rem;
}
.criteria-table th { font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; }
.criteria-pass { color: var(--c3); font-weight: 700; }
.criteria-fail { color: var(--c1); font-weight: 700; }
.evidence-cell { font-size: 0.8rem; font-style: italic; color: #555; max-width: 300px; }

/* ── Collapsible ── */
.collapsible { border: var(--border); margin: 1rem 0; }
.collapsible-header {
  padding: 0.75rem 1rem;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 0.95rem;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  user-select: none;
  background: var(--bg);
}
.collapsible-header::after { content: '+'; font-family: var(--font-mono); font-size: 1.2rem; transition: transform 0.3s; }
.collapsible.open .collapsible-header::after { transform: rotate(45deg); }
.collapsible-body { max-height: 0; overflow: hidden; transition: max-height 0.4s ease; padding: 0 1rem; }
.collapsible.open .collapsible-body { max-height: 5000px; padding: 1rem; }

/* ── Prescription cards ── */
.prescription-card {
  border: var(--border);
  border-left-width: 6px;
  padding: 1rem 1.25rem;
  margin: 0.75rem 0;
  background: var(--bg);
}
.prescription-card p { font-size: 0.9rem; }

/* ── Takeaway ── */
.takeaway {
  border: var(--border);
  box-shadow: var(--shadow);
  padding: 1.25rem 1.5rem;
  margin: 1.5rem 0;
  background: var(--bg);
}
.takeaway-label {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  margin-bottom: 0.5rem;
}
.takeaway p { font-weight: 500; font-size: 0.95rem; }

/* ── Lists ── */
.tag-list { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.75rem 0; }
.tag {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  padding: 0.2rem 0.6rem;
  border: 2px solid var(--fg);
}
.tag-green { border-color: var(--c3); background: #e8f5e9; }
.tag-red { border-color: var(--c1); background: #ffebee; }

/* ── Footer ── */
footer {
  text-align: center;
  padding: 2rem;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  opacity: 0.5;
  border-top: var(--border);
}

/* ── Responsive ── */
@media (max-width: 768px) {
  .expert-panel { grid-template-columns: 1fr; }
  html { font-size: 16px; }
}

@media print {
  .collapsible-body { max-height: none !important; padding: 1rem !important; }
  .collapsible-header::after { display: none; }
  body { font-size: 12pt; }
}
</style>
</head>
<body>

{% block hero %}{% endblock %}

<div class="container">
{% block experts %}{% endblock %}
{% block expert_details %}{% endblock %}
{% block synthesis %}{% endblock %}
{% block summary %}{% endblock %}
</div>

<footer>
  Evaluación generada el {{ date }} &middot; Evaluador Curricular UPAEP
</footer>

<script>
document.querySelectorAll('.collapsible-header').forEach(h => {
  h.addEventListener('click', () => h.parentElement.classList.toggle('open'));
});
</script>
</body>
</html>
